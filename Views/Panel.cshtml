@model MegaMenuPanelModel
@using Nop.Core.Domain.Catalog
@*
    Extra columns of a main menu dropdown (widget zone nopwara_megamenu_panel, rendered by the Nopwara theme next to the
    core grid/list columns). The mobile menu renders the same component in nopwara_megamenu_panel_mobile: promo only.
*@
@{
    var mobile = ViewData["Mobile"] as bool? == true;
}
@if (mobile)
{
    if (Model.HasPromo)
    {
        <div class="nopwara-megamenu-promo px-4 pb-4 pt-2">
            @await Html.PartialAsync("_Promo.cshtml", Model)
        </div>
    }
    return;
}
<div class="nopwara-megamenu-panel flex flex-col gap-6 lg:flex-row lg:gap-8" data-menu-item="@Model.Key">
    @if (Model.HasProducts)
    {
        <div class="nopwara-megamenu-products min-w-0 lg:w-[26rem] lg:shrink-0">
            @if (!string.IsNullOrWhiteSpace(Model.ProductsTitle))
            {
                <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">@Model.ProductsTitle</p>
            }
            @*cards come from ProductsUrl the first time the dropdown opens (nopwaraLoadPanel in the theme); grey cards until then*@
            <div data-megamenu-products="@Model.ProductsUrl">
                <ul class="grid @(Model.ProductCount == 3 ? "grid-cols-3 gap-3" : "grid-cols-2 gap-4")" aria-hidden="true">
                    @for (var i = 0; i < Model.ProductCount; i++)
                    {
                        <li class="p-2">
                            <span class="mb-2 block aspect-square w-full animate-pulse rounded-md bg-slate-100"></span>
                            <span class="block h-3 w-4/5 animate-pulse rounded bg-slate-100"></span>
                            <span class="mt-2 block h-3 w-1/3 animate-pulse rounded bg-slate-100"></span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    @if (Model.HasContent)
    {
        <div class="nopwara-megamenu-content min-w-0 lg:w-72 lg:shrink-0">
            @if (!string.IsNullOrWhiteSpace(Model.ContentTitle))
            {
                <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">@Model.ContentTitle</p>
            }
            @*topic body / HTML entered in admin*@
            <div class="space-y-2 text-sm leading-relaxed text-slate-600 [&_a]:font-medium [&_a]:text-primary-600 [&_a:hover]:underline [&_li]:ml-4 [&_ul]:list-disc [&_h2]:text-sm [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h3]:font-semibold [&_h3]:text-slate-900">
                @Html.Raw(Model.ContentHtml)
            </div>
        </div>
    }
    @if (Model.HasPromo)
    {
        <div class="nopwara-megamenu-promo lg:w-64 lg:shrink-0">
            @await Html.PartialAsync("_Promo.cshtml", Model)
        </div>
    }
</div>
