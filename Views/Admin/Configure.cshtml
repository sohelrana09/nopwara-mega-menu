@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="NopwaraMegaMenuAdmin" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <p>@T("Plugins.Widgets.NopwaraMegaMenu.Instructions")</p>
                    <p>
                        <a asp-controller="NopwaraMegaMenuAdmin" asp-action="List" class="btn btn-default">
                            <i class="fas fa-bars"></i> @T("Plugins.Widgets.NopwaraMegaMenu.ManageItems")
                        </a>
                    </p>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="ProductPictureSize" /></div>
                        <div class="col-md-9"><nop-editor asp-for="ProductPictureSize" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="PromoPictureSize" /></div>
                        <div class="col-md-9"><nop-editor asp-for="PromoPictureSize" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <input type="submit" name="save" class="btn btn-primary" value="@T("Admin.Common.Save")" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
